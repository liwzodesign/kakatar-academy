# --- Copier en .env et remplir (ne jamais committer .env) ---

# Django
SECRET_KEY=remplacer-par-une-longue-chaine-aleatoire
ALLOWED_HOSTS=academy.kakatargraphic.com,localhost
CSRF_TRUSTED_ORIGINS=https://academy.kakatargraphic.com
CORS_ALLOWED_ORIGINS=https://academy.kakatargraphic.com
# Mettre True seulement si le HTTPS est géré par ce serveur (sinon le proxy en amont s'en charge)
SECURE_SSL_REDIRECT=False

# URLs publiques (redirections après paiement, webhooks, lien du certificat)
FRONTEND_URL=https://academy.kakatargraphic.com
BACKEND_URL=https://academy.kakatargraphic.com

# Base de données
DB_NAME=kakatar_academy
DB_USER=kakatar
DB_PASSWORD=changer-moi

# Premier compte administrateur (créé au démarrage s'il n'existe pas)
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_FIRST_NAME=Ndiogou
DJANGO_SUPERUSER_LAST_NAME=Ba

# Wave Business (clé API Checkout + secret de webhook, depuis le portail Wave Business)
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=

# PayDunya (Orange Money, Free Money, cartes) - mode test ou live
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=test
PAYDUNYA_STORE_NAME=Kakatar Academy

# Emails (réinitialisation du mot de passe). Par défaut : affichés dans la console.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Kakatar Academy <noreply@kakatargraphic.com>
