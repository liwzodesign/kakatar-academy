# =============================================================================
# Kakatar Academy — configuration (copier en « .env » à la racine pour Docker,
# ou en « backend/.env » pour le développement local). Ne jamais committer .env.
# =============================================================================

# --- Django ---
DEBUG=False
# Générer : python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,backend,mondomaine.com
CSRF_TRUSTED_ORIGINS=https://mondomaine.com
FRONTEND_URL=https://mondomaine.com
BACKEND_URL=https://mondomaine.com
CORS_ALLOWED_ORIGINS=https://mondomaine.com
# Mettre True une fois HTTPS en place (certbot, Cloudflare…)
SECURE_SSL_REDIRECT=False

# Superutilisateur créé au premier démarrage (facultatif)
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# --- Base de données (Docker) ---
POSTGRES_DB=kakatar_academy
POSTGRES_USER=kakatar
POSTGRES_PASSWORD=
# Hors Docker (backend/.env) : DATABASE_URL=postgres://user:pass@localhost:5432/kakatar_academy
# Durée de vie des connexions PostgreSQL (secondes). Par défaut : 60 en production, 0 si DEBUG=True.
# DB_CONN_MAX_AGE=60
# PostgreSQL est obligatoire (SQLite n'est pas pris en charge).

# --- Emails ---
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Kakatar Academy <noreply@mondomaine.com>
# Avec le profil docker « dev » : EMAIL_HOST=mailhog EMAIL_PORT=1025 EMAIL_USE_TLS=False

# --- Paiements ---
# Sans clé, une passerelle fonctionne en mode simulé si PAYMENTS_ALLOW_SANDBOX=True.
PAYMENTS_ALLOW_SANDBOX=False
PLATFORM_COMMISSION_RATE=15
# Montant minimum d'une demande de versement formateur (FCFA)
PAYOUT_MINIMUM=5000
# Réduction offerte au parrain au premier achat d'un filleul (%)
REFERRAL_REWARD_PERCENT=20
DEFAULT_CURRENCY=XOF

STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# webhook : https://mondomaine.com/api/v1/payments/webhooks/stripe/
STRIPE_WEBHOOK_SECRET=

# test | live
PAYDUNYA_MODE=test
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_PRIVATE_KEY=
# IPN : https://mondomaine.com/api/v1/payments/webhooks/paydunya/
PAYDUNYA_TOKEN=

WAVE_API_KEY=
# webhook : https://mondomaine.com/api/v1/payments/webhooks/wave/
WAVE_WEBHOOK_SECRET=

# --- Stockage S3 / Cloudflare R2 (facultatif ; sinon disque local) ---
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
# R2 : https://<compte>.r2.cloudflarestorage.com
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

# --- IA (facultatif ; sinon heuristiques locales) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Sessions en direct ---
LIVE_MEETING_BASE_URL=https://meet.jit.si

# --- Supervision ---
SENTRY_DSN=
FLOWER_USER=admin
FLOWER_PASSWORD=
GRAFANA_PASSWORD=
